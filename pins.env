# Pins for DeepSeek-V4.1-Flash-1017 on NVIDIA Hyperflare (TP=4, one rank per Spark).
# Read by scripts/*.sh, not by the unit.
# The official checkpoint: MXFP4 routed experts, FP8 Engram tables (475.3 GiB, 48 shards).
DSV41F_MODEL_ID=deepseek-ai/DeepSeek-V4.1-Flash-1017
DSV41F_MODEL_REVISION=1bae0e1088993b9b82de08f59de5be5a34e42170
# NVIDIA renamed flare-local-inference to hyperflare-inference on 2026-11-09; the CLI is still `flare`.
FLARE_REPO=https://github.com/NVIDIA/hyperflare-inference.git
FLARE_COMMIT=7f534bb66c26e3b380cf0a6ac1fb3c4b04d87722   # main, 2026-11-10
# One recipe patch on 7f534bb6:
# patches/0012 clears PyTorch's cached cuBLAS workspaces before the first graph capture. Without it the
#   first captured graph keeps a split-K workspace from transient export storage: with
#   --prefill-chunk-size 8192 every prompt above 7,168 tokens faults (Xid 31) on all ranks; with 4096 the
#   address is covered by another allocation by chance (Hyperflare issue #266).
# Upstream main now carries every earlier recipe patch: 0004 forced tool_choice (585702d3), 0007 literal
# image placeholders (ac7bfa9a), 0008 snapshot slots (be744283, #168, slots bounded by KV memory),
# 0009 parallel re-hash of a peer's rank (47e92c38, issue #93), and before them 0002 (37c87e1d),
# 0003 (e350914a), 0005 (a7d51ca1), 0006 (67ba265e, 03940fa5).
FLARE_CUDA=/usr/local/cuda-13.3
FLARE_HOME=/opt/spark-llm/profiles/deepseek-v41-1017-flare
# One source tree per pin, so a new build never touches the tree a running card uses.
FLARE_SRC=/opt/spark-llm/profiles/deepseek-v41-1017-flare/src-7f534bb6
# The native CLI builds from flare-cli/ since bbad44fe.
FLARE_BIN=$FLARE_SRC/flare-cli/target/release
# The checkpoint (scripts/fetch.sh). Rank 0 only: the export sends the peers their part.
DSV41F_MODEL_DIR=/srv/spark-llm/models/deepseek-v41-1017-official
DSV41F_PACKAGE_DIR=/srv/spark-llm/flare-runtime
