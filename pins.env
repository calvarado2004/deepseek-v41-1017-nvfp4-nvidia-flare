# Pins for DeepSeek-V4.1-Flash-1017 on NVIDIA Flare (TP=4, one rank per Spark).
# Read by scripts/*.sh, not by the unit.
# The official checkpoint: MXFP4 routed experts, FP8 Engram tables (475.3 GiB, 48 shards).
DSV41F_MODEL_ID=deepseek-ai/DeepSeek-V4.1-Flash-1017
DSV41F_MODEL_REVISION=1bae0e1088993b9b82de08f59de5be5a34e42170
FLARE_REPO=https://github.com/NVIDIA/flare-local-inference.git
FLARE_COMMIT=bce032c014bae34502ba22d3304fa084d5b40afe   # main, 2026-10-24
# patches/0004 forced tool_choice without a thinking request encodes in chat mode
# patches/0007 literal "<｜image｜>" / "<｜deepseek_image｜>" in request text is plain text
# patches/0008 long conversations stay warm under snapshot-slot pressure (Flare issue #47):
#   GreedyDual-Size eviction by recompute tokens, and --prefix-cache-snapshots
# patches/0009 (Flare issue #93) a warm start re-hashes each peer's cached 280 GB rank; the hash now runs on parallel
#   workers with overlapped direct reads: 7-9.5 min -> 71 s from start to serving (2026-10-26)
# Upstream main now carries the fixes of the earlier patches: 0002 shared memory (37c87e1d),
# 0003 RoCE proxy ABI 10 (e350914a), 0005 terminal snapshots (a7d51ca1, in place of PR #75),
# 0006 message boundaries in one pass (67ba265e, 03940fa5).
FLARE_CUDA=/usr/local/cuda-13.3
FLARE_HOME=/opt/spark-llm/profiles/deepseek-v41-1017-flare
# One source tree per pin, so a new build never touches the tree a running card uses.
FLARE_SRC=/opt/spark-llm/profiles/deepseek-v41-1017-flare/src-bce032c0
# The checkpoint (scripts/fetch.sh). Rank 0 only: the export sends the peers their part.
DSV41F_MODEL_DIR=/srv/spark-llm/models/deepseek-v41-1017-official
DSV41F_PACKAGE_DIR=/srv/spark-llm/flare-runtime
