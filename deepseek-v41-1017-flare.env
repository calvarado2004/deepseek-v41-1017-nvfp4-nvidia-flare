# /etc/spark-llm/profiles/deepseek-v41-1017-flare.env, read by
# spark-llm-dsv41-flare@.service on all four ranks. Unset keys take the
# launcher's defaults (bin/launch-rank). scripts/stage.sh appends
# DSV41F_MASTER_ADDR from cluster.env.
# Found by the launcher when empty: on rank 0 the one exported cache entry,
# ~/.cache/flare/packages/models/<model>/<version>/model.safetensors (the export log
# prints it), and on every node the one publisher profile in ~/.cache/flare/publishers/
# (its file name is the key's fingerprint). Set them when a node holds more than one.
DSV41F_PACKAGE=
DSV41F_PUBLISHER_KEY=
DSV41F_PUBLISHER=local-development
DSV41F_SERVED_MODEL_NAME=DeepSeek-V4.1-Flash-1017-Flare
# Engram row cache per host. 0 sends every row to NVMe (4.6 ms a gather); 6G keeps
# ~8 GiB MemAvailable on GB10, where host RAM is GPU memory.
DSV41F_ENGRAM_CACHE=6G
# Extra `flare run` flags; the package defaults keep adaptive DSpark verification
# (--no-mtp-adaptive-verification measured slower: code 78.5 vs 89.3 tok/s, prose
# 35.6 vs 41.6, and no drafts at batch > 1).
# Patch 0008: 256 snapshot slots instead of 32 (8 x concurrency 4), so a long agent
# session keeps its prefix while subagents and side queries run. A slot borrows about
# 82 KV pages only while it holds a checkpoint: 256 full slots take ~2.7M of the
# ~22M KV tokens. Every rank needs the same value (the ranks agree on the smallest).
DSV41F_EXTRA_FLAGS="--prefix-cache-snapshots 256"
# Crash recovery (bin/recover-card on rank 0): a card that was serving and crashed is
# restarted, all ranks, peers first, at most DSV41F_RECOVER_MAX times in
# DSV41F_RECOVER_WINDOW seconds; the next crash stays down for a person. 0 turns it off.
# scripts/stage.sh adds DSV41F_RECOVER_PEERS from cluster.env.
DSV41F_RECOVER_MAX=3
DSV41F_RECOVER_WINDOW=86400
