# /etc/spark-llm/profiles/deepseek-v41-1017-flare.env, read by
# spark-llm-dsv41-flare@.service on all four ranks. Unset keys take the
# launcher's defaults (bin/launch-rank). scripts/stage.sh appends
# DSV41F_MASTER_ADDR from cluster.env.
DSV41F_PACKAGE_NAME=dsv41-1017-official-tp4ring-c4-dspark5-csf
DSV41F_PACKAGE_DIR=/srv/spark-llm/flare-runtime
# Found by the launcher when empty: the one ~/.cache/flare/packages/*-rank<N>/ that
# holds the package (peers), and the one publisher profile in
# ~/.cache/flare/publishers/ (its file name is the key's fingerprint). Set them when
# a node holds more than one.
DSV41F_PACKAGE_ID=
DSV41F_PUBLISHER_KEY=
DSV41F_PUBLISHER=local-development
DSV41F_SERVED_MODEL_NAME=DeepSeek-V4.1-Flash-1017-Flare
# Engram row cache per host. 0 sends every row to NVMe (4.6 ms a gather); 6G keeps
# ~8 GiB MemAvailable on GB10, where host RAM is GPU memory.
DSV41F_ENGRAM_CACHE=6G
# Extra `flare run` flags. Empty = package defaults (adaptive DSpark verification).
# --no-mtp-adaptive-verification measured slower: code 78.5 vs 89.3 tok/s, prose
# 35.6 vs 41.6, and no drafts at batch > 1.
DSV41F_EXTRA_FLAGS=
