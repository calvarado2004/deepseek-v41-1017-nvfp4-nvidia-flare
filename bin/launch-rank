#!/usr/bin/env bash

# Run one rank of DeepSeek-V4.1-Flash-1017 (official deepseek-ai weights) on NVIDIA Flare at TP=4
# across four Sparks cabled in a loop with no switch:
#
#   rank 0 -> rank 1 -> rank 2 -> rank 3 -> rank 0 (one QSFP cable each)
#
# Engine: Flare (Helios runtime) at pins.env FLARE_COMMIT plus ../patches, running the
# signed package that scripts/export.sh wrote. This is Flare's documented manual mode
# (docs/multi-host.md, "Start ranks manually"): the same command line the Flare agent
# gives each rank, so one systemd unit holds one rank and its journal holds the log.
# Rank 0 also serves HTTP on 127.0.0.1:8001 and runs the TLS front on :8888 (Flare
# speaks plain HTTP only).
#
# Rendezvous on the fabric (DSV41F_MASTER_ADDR): the per-step control stream between
# the ranks. On Wi-Fi it cost 37-61 ms a decode round and halved the speed.
#
# Trust: the package is signed by your local development key. scripts/distribute.sh
# accepts it once and leaves its public profile in ~/.cache/flare/publishers on every
# node; --dangerously-approve-key pins that exact fingerprint, as the agent does for
# its ranks (docs/cli-design.md, signing and local development).

set -euo pipefail

if [ "$#" -ne 1 ] || [[ ! "$1" =~ ^[0-3]$ ]]; then
  echo "usage: $0 <node-rank: 0..3>" >&2; exit 2
fi
NODE_RANK="$1"

RUNTIME_ROOT="${DSV41F_RUNTIME_ROOT:-/opt/spark-llm/profiles/deepseek-v41-1017-flare}"
FLARE="${DSV41F_FLARE:-$RUNTIME_ROOT/src/flare/target/release/flare}"
PACKAGE_NAME="${DSV41F_PACKAGE_NAME:-dsv41-1017-official-tp4ring-c4-dspark5-csf}"
PACKAGE_DIR="${DSV41F_PACKAGE_DIR:-/srv/spark-llm/flare-runtime}"
PACKAGE_ID="${DSV41F_PACKAGE_ID:-}"
PUBLISHER_KEY="${DSV41F_PUBLISHER_KEY:-}"
PUBLISHER="${DSV41F_PUBLISHER:-local-development}"
MASTER_ADDR="${DSV41F_MASTER_ADDR:?DSV41F_MASTER_ADDR unset (rank 0 fabric address; scripts/stage.sh sets it)}"
MASTER_PORT="${DSV41F_MASTER_PORT:-29800}"
HTTP_PORT="${DSV41F_HTTP_PORT:-8001}"
PORT="${DSV41F_PORT:-8888}"
SERVED_MODEL_NAME="${DSV41F_SERVED_MODEL_NAME:-DeepSeek-V4.1-Flash-1017-Flare}"
# Engram row cache per host; 0 sends every row to NVMe (4.6 ms a gather).
ENGRAM_CACHE="${DSV41F_ENGRAM_CACHE:-6G}"
# Extra `flare run` flags. Empty = package defaults (adaptive verification: faster on
# every bench, and the only mode that drafts at batch > 1).
EXTRA_FLAGS="${DSV41F_EXTRA_FLAGS:-}"

# one PATTERN WHAT: the single path that matches PATTERN, or fail with a hint.
one() {
  local matches=()
  for f in $1; do [ -e "$f" ] && matches+=("$f"); done
  if [ "${#matches[@]}" -ne 1 ]; then
    echo "found ${#matches[@]} $2 ($1): set it in the env file" >&2; exit 1
  fi
  echo "${matches[0]}"
}

# Rank 0 exported the package; the peers hold the rank files the agent sent them.
if [ "$NODE_RANK" = 0 ]; then
  package="$PACKAGE_DIR/$PACKAGE_NAME.safetensors"
elif [ -n "$PACKAGE_ID" ]; then
  package="$HOME/.cache/flare/packages/${PACKAGE_ID}-rank${NODE_RANK}/$PACKAGE_NAME.safetensors"
else
  package="$(one "$HOME/.cache/flare/packages/*-rank${NODE_RANK}/$PACKAGE_NAME.safetensors" "rank packages (DSV41F_PACKAGE_ID)")"
fi
if [ -n "$PUBLISHER_KEY" ]; then
  profile="$HOME/.cache/flare/publishers/$PUBLISHER_KEY.json"
else
  profile="$(one "$HOME/.cache/flare/publishers/*.json" "publisher profiles (DSV41F_PUBLISHER_KEY)")"
  PUBLISHER_KEY="$(basename "$profile" .json)"
fi
for f in "$FLARE" "$package" "$profile"; do
  [ -f "$f" ] || { echo "missing $f (README, quick start)" >&2; exit 1; }
done

args=(run "$package" --rank "$NODE_RANK" --roce-ring --gpus 0
      --embedding-table-cache-size "$ENGRAM_CACHE"
      --publisher-keys "$profile"
      --dangerously-approve-key "$PUBLISHER_KEY"
      --dangerously-accept-publisher "$PUBLISHER")
if [ "$NODE_RANK" = 0 ]; then
  args+=(--rendezvous "0.0.0.0:$MASTER_PORT" --host 127.0.0.1 --port "$HTTP_PORT"
         --served-model-name "$SERVED_MODEL_NAME")
else
  args+=(--rendezvous "$MASTER_ADDR:$MASTER_PORT")
fi
# shellcheck disable=SC2206
[ -n "$EXTRA_FLAGS" ] && args+=($EXTRA_FLAGS)

echo "DeepSeek-V4.1-Flash-1017 on Flare tp=4 rank=$NODE_RANK package=$package" \
     "rendezvous=$MASTER_ADDR:$MASTER_PORT engram_cache=$ENGRAM_CACHE extra=[${EXTRA_FLAGS}]"

"$FLARE" "${args[@]}" < /dev/null &
rank_pid=$!

# Headless ranks report ready once the rank runs (gating them on the head deadlocks a
# start that brings the peers up first).
if [ "$NODE_RANK" != 0 ]; then
  sleep 2
  kill -0 "$rank_pid" 2>/dev/null && [ -n "${NOTIFY_SOCKET:-}" ] \
    && systemd-notify --ready --status="rank $NODE_RANK, at the rendezvous $MASTER_ADDR:$MASTER_PORT"
  wait "$rank_pid"; exit $?
fi

# Rank 0: the TLS front lives and dies with the rank.
python3 -I "$RUNTIME_ROOT/bin/tls-front.py" &
front_pid=$!
trap 'kill "$front_pid" 2>/dev/null || true' EXIT

(
  base="https://127.0.0.1:${PORT}"
  deadline=$(( $(date +%s) + ${DSV41F_READY_TIMEOUT:-1800} ))
  while [ "$(date +%s)" -lt "$deadline" ]; do
    kill -0 "$rank_pid" 2>/dev/null || exit 0
    if curl -sk -m 5 -o /dev/null -f "$base/health" 2>/dev/null; then
      # Run the concurrent batch shapes once before anyone can send a burst.
      body="{\"model\":\"$SERVED_MODEL_NAME\",\"messages\":[{\"role\":\"user\",\"content\":\"Count from 1 to 20.\"}],\"max_tokens\":32,\"chat_template_kwargs\":{\"enable_thinking\":false}}"
      for _ in 1 2 3 4; do
        curl -sk -m 900 -o /dev/null -H 'Content-Type: application/json' -d "$body" \
          "$base/v1/chat/completions" &
      done
      wait
      kill -0 "$rank_pid" 2>/dev/null || exit 0
      [ -n "${NOTIFY_SOCKET:-}" ] && systemd-notify --ready --status="serving on :${PORT}"
      exit 0
    fi
    [ -n "${NOTIFY_SOCKET:-}" ] && systemd-notify --status="loading (rank 0)"
    sleep 5
  done
  [ -n "${NOTIFY_SOCKET:-}" ] && systemd-notify --status="not ready after ${DSV41F_READY_TIMEOUT:-1800}s"
) &
wait "$rank_pid"
