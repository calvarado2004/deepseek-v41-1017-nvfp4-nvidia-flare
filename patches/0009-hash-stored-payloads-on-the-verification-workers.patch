@@ -21,6 +21,165 @@ use std::{
 
 pub(super) const CHUNK: usize = 4 << 20;
 
+/// Hash stored payloads on the package reader's verification workers. One reader that reads and
+/// hashes in turn stays far below NVMe bandwidth (0.7 GB/s against 9-13 GB/s on GB10), so a
+/// cached multi-host rank of 280 GB took 7 minutes to re-verify on every start. Every payload is
+/// still hashed; the first failure in payload order is returned.
+/// Bytes of one direct read while a stored payload is hashed.
+const DIRECT_HASH_BLOCK: usize = 16 << 20;
+/// Direct-read buffers per payload: one being hashed, two being read.
+const DIRECT_HASH_BUFFERS: usize = 3;
+
+/// Hash one stored payload against its id. A reader thread fills aligned direct-I/O blocks while
+/// this thread hashes the previous one, so one payload streams at SHA-256 speed (98 GB Engram
+/// planes took 3 minutes through 4 MiB buffered reads on GB10, where the page cache also takes
+/// GPU memory). A filesystem that refuses direct I/O is read through the page cache.
+fn hash_stored(file: &super::archive::PayloadFile, nbytes: u64, id: &[u8]) -> Result<()> {
+    let direct = if nbytes == 0 {
+        None
+    } else {
+        file.direct().ok()
+    };
+    let digest = match direct.map(|direct| hash_direct(&direct, file.start, nbytes)) {
+        Some(Ok(digest)) => digest,
+        Some(Err(error)) if error.raw_os_error() != Some(libc::EINVAL) => {
+            return Err(invalid(format!("read payload: {error}")));
+        }
+        _ => hash_buffered(&file.file, file.start, nbytes)?,
+    };
+    if digest.as_ref() != id {
+        return Err(invalid("payload content verification failed"));
+    }
+    Ok(())
+}
+
+fn hash_buffered(file: &File, start: u64, nbytes: u64) -> Result<digest::Digest> {
+    let mut context = digest::Context::new(&digest::SHA256);
+    let mut buffer = vec![0u8; CHUNK];
+    let mut offset = 0u64;
+    while offset < nbytes {
+        let count = usize::try_from((nbytes - offset).min(CHUNK as u64))
+            .map_err(|_| invalid("payload hash length overflow"))?;
+        FileReadAt::read_exact_at(file, &mut buffer[..count], start + offset)
+            .map_err(|error| invalid(format!("read payload: {error}")))?;
+        context.update(&buffer[..count]);
+        offset += count as u64;
+    }
+    Ok(context.finish())
+}
+
+/// SHA-256 of `nbytes` at `start`, read in aligned blocks of `DIRECT_HASH_BLOCK` through a
+/// direct-I/O handle. The bytes around the payload inside the first and last block are skipped.
+fn hash_direct(file: &File, start: u64, nbytes: u64) -> io::Result<digest::Digest> {
+    use std::sync::mpsc::sync_channel;
+
+    const ALIGN: u64 = 4096;
+    let end = start + nbytes;
+    let first = start - start % ALIGN;
+    let block = DIRECT_HASH_BLOCK as u64;
+    let blocks = (end - first).div_ceil(block);
+    // A Vec moved between threads keeps its heap address, so the aligned window stays valid.
+    let window = |buffer: &[u8]| buffer.as_ptr().align_offset(ALIGN as usize);
+    let (filled_tx, filled_rx) = sync_channel::<io::Result<(Vec<u8>, u64, usize)>>(DIRECT_HASH_BUFFERS);
+    let (empty_tx, empty_rx) = sync_channel::<Vec<u8>>(DIRECT_HASH_BUFFERS);
+    for _ in 0..DIRECT_HASH_BUFFERS {
+        empty_tx
+            .send(vec![0u8; DIRECT_HASH_BLOCK + ALIGN as usize])
+            .expect("empty buffer channel has room for every buffer");
+    }
+    std::thread::scope(|scope| {
+        scope.spawn(move || {
+            for index in 0..blocks {
+                let Ok(mut buffer) = empty_rx.recv() else {
+                    return;
+                };
+                let position = first + index * block;
+                let skip = window(&buffer);
+                let wanted = (end - position).min(block).div_ceil(ALIGN) * ALIGN;
+                let target = &mut buffer[skip..skip + wanted as usize];
+                let mut filled = 0usize;
+                let result = loop {
+                    if filled == target.len() {
+                        break Ok(filled);
+                    }
+                    match FileReadAt::read_at(file, &mut target[filled..], position + filled as u64) {
+                        // End of file inside the last aligned block.
+                        Ok(0) if position + filled as u64 >= end => break Ok(filled),
+                        Ok(0) => break Err(io::ErrorKind::UnexpectedEof.into()),
+                        Ok(count) => filled += count,
+                        Err(error) if error.kind() == io::ErrorKind::Interrupted => {}
+                        Err(error) => break Err(error),
+                    }
+                };
+                let failed = result.is_err();
+                if filled_tx.send(result.map(|filled| (buffer, position, filled))).is_err() || failed {
+                    return;
+                }
+            }
+        });
+        let mut context = digest::Context::new(&digest::SHA256);
+        for _ in 0..blocks {
+            let (buffer, position, filled) = filled_rx
+                .recv()
+                .map_err(|_| io::Error::other("payload reader stopped"))??;
+            let skip = window(&buffer);
+            let low = start.saturating_sub(position) as usize;
+            let high = ((end - position) as usize).min(filled);
+            if high < low {
+                return Err(io::ErrorKind::UnexpectedEof.into());
+            }
+            context.update(&buffer[skip + low..skip + high]);
+            // The reader may have finished; a closed channel only means no more blocks.
+            let _ = empty_tx.send(buffer);
+        }
+        Ok(context.finish())
+    })
+}
+
+fn hash_payloads(
+    ids: &std::collections::BTreeSet<Vec<u8>>,
+    hash: impl Fn(&[u8]) -> Result<()> + Sync,
+) -> Result<()> {
+    use std::sync::{
+        Mutex,
+        atomic::{AtomicUsize, Ordering},
+    };
+
+    let ids: Vec<&[u8]> = ids.iter().map(Vec::as_slice).collect();
+    let workers = payload_reader::verification_workers(ids.len());
+    if workers <= 1 {
+        return ids.into_iter().try_for_each(&hash);
+    }
+    let cursor = AtomicUsize::new(0);
+    let results = Mutex::new((0..ids.len()).map(|_| None).collect::<Vec<Option<Result<()>>>>());
+    let mut spawn_error = None;
+    std::thread::scope(|scope| {
+        for _ in 0..workers {
+            let worker = std::thread::Builder::new().spawn_scoped(scope, || {
+                loop {
+                    let index = cursor.fetch_add(1, Ordering::Relaxed);
+                    let Some(id) = ids.get(index) else {
+                        break;
+                    };
+                    let result = hash(id);
+                    results.lock().expect("payload hash result mutex")[index] = Some(result);
+                }
+            });
+            if let Err(error) = worker {
+                spawn_error = Some(error);
+                break;
+            }
+        }
+    });
+    if let Some(error) = spawn_error {
+        return Err(invalid(format!("spawn payload hasher: {error}")));
+    }
+    for result in results.into_inner().expect("payload hash result mutex") {
+        result.expect("every payload hash worker must record a result")?;
+    }
+    Ok(())
+}
+
