+#[cfg(test)]
+mod stored_hash_tests {
+    use super::*;
+    use std::io::Write as _;
+
+    #[test]
+    fn direct_hash_matches_buffered_hash_on_unaligned_ranges() {
+        let length = 2 * DIRECT_HASH_BLOCK as u64 + 12_345;
+        let bytes: Vec<u8> = (0..length).map(|i| (i * 31 % 251) as u8).collect();
+        let directory =
+            std::env::temp_dir().join(format!("helios-stored-hash-{}", std::process::id()));
+        std::fs::create_dir_all(&directory).unwrap();
+        let path = directory.join("payload.bin");
+        File::create(&path).unwrap().write_all(&bytes).unwrap();
+        let file = File::open(&path).unwrap();
+        let result = std::panic::catch_unwind(|| check(&file, &bytes, length));
+        std::fs::remove_dir_all(&directory).unwrap();
+        if let Err(panic) = result {
+            std::panic::resume_unwind(panic);
+        }
+    }
+
+    fn check(file: &File, bytes: &[u8], length: u64) {
+        let block = DIRECT_HASH_BLOCK as u64;
+        let direct = match crate::os::direct_reopen(file) {
+            Ok(direct) => direct,
+            Err(error) => {
+                eprintln!("skipping: the temporary directory refuses direct I/O: {error}");
+                return;
+            }
+        };
+        let ranges = [
+            (0, 1),
+            (0, length),
+            (1, length - 1),
+            (4095, 4097),
+            (block - 7, 14),
+            (block - 1, block + 2),
+            (3, 2 * block),
+            (length - 5, 5),
+        ];
+        for (start, nbytes) in ranges {
+            let expected = digest::digest(
+                &digest::SHA256,
+                &bytes[start as usize..(start + nbytes) as usize],
+            );
+            let buffered = hash_buffered(file, start, nbytes).unwrap();
+            assert_eq!(buffered.as_ref(), expected.as_ref(), "buffered {start}+{nbytes}");
+            match hash_direct(&direct, start, nbytes) {
+                Ok(found) => assert_eq!(found.as_ref(), expected.as_ref(), "direct {start}+{nbytes}"),
+                Err(error) if error.raw_os_error() == Some(libc::EINVAL) => {
+                    eprintln!("skipping direct: {error}");
+                    return;
+                }
+                Err(error) => panic!("direct {start}+{nbytes}: {error}"),
+            }
+        }
+        // A range past the end of the file is a read error, not a short digest.
+        assert!(hash_direct(&direct, length - 3, 10).is_err());
+    }
+}
