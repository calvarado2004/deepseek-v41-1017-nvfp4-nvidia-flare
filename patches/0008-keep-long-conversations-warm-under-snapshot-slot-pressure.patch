+/// Serves one request whose prompt extends at most one prefill chunk past its cached prefix,
+/// publishes its terminal checkpoint, and returns the tokens admission reused.
+fn serve_to_checkpoint(scheduler: &mut RequestScheduler, prompt: Vec<u32>, fence: &mut u64) -> u64 {
+    let tokens = prompt.len();
+    let handle = scheduler
+        .admit(RequestSpec { prompt, ..spec(0, 1) })
+        .unwrap();
+    let reused = scheduler.request(handle).unwrap().consumed_tokens;
+    *fence += 1;
+    init(scheduler, *fence);
+    *fence += 1;
+    let step = scheduler.plan().unwrap();
+    assert_eq!(step.kind, GraphKind::Prefill);
+    scheduler.commit(&step, Fence(*fence)).unwrap();
+    scheduler
+        .complete(
+            Fence(*fence),
+            &records(handle, *fence, tokens as i64, 1, 77, 2),
+            Default::default(),
+        )
+        .unwrap();
+    *fence += 1;
+    freeze(scheduler, handle, *fence);
+    scheduler.finish(handle).unwrap().unwrap();
+    reused
+}
+
+#[test]
+fn long_conversation_stays_warm_while_short_requests_churn_snapshot_slots() {
+    // Three slots, as a coding agent's main conversation shares them with its subagents.
+    let mut scheduler = scheduler(1, 64, 3);
+    let mut fence = 0;
+    assert_eq!(serve_to_checkpoint(&mut scheduler, (0..512).collect(), &mut fence), 0);
+    for request in 1..=6u32 {
+        let prompt = (request * 10_000..request * 10_000 + 64).collect();
+        assert_eq!(serve_to_checkpoint(&mut scheduler, prompt, &mut fence), 0);
+    }
+    assert!(scheduler.stats().snapshot_evictions >= 4);
+    // The follow-up turn resumes from the conversation's endpoint instead of prefilling it again.
+    assert_eq!(serve_to_checkpoint(&mut scheduler, (0..576).collect(), &mut fence), 512);
+}
