+"""GPU prefix retention qualification: one long conversation must stay warm while
+many short conversations churn the snapshot slots, as a coding agent's main
+session does while its subagents and side queries run.
+
+The scenario publishes a long conversation, then runs more short conversations
+than the server has snapshot slots, each a few turns long with its own system
+prompt, and finally sends the long conversation's next turn. The follow-up must
+reuse the conversation's prefix from the GPU cache: its cached tokens must cover
+the previous turn's prompt, and it must answer a fact from the start of the
+conversation. With least-recently-used eviction the short conversations retire
+the long conversation's endpoint and the follow-up prefills it again.
+
+Run against a serving rank zero, or let the script launch `flare run`:
+
+    python3 -m qualify.prefix_retention --url http://127.0.0.1:8000 --conversation-tokens 300000
+    python3 -m qualify.prefix_retention --flare flare/target/release/flare \\
+        --package /data/model.safetensors --gpus 0 --artifacts /data/prefix-retention
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import random
+import re
+import time
+import urllib.request
+from pathlib import Path
+
+WORDS = (
+    "amber basil cedar delta ember fjord garnet harbor indigo juniper kestrel lantern "
+    "meadow nectar orchid pepper quartz raven saffron tundra umber violet willow xenon "
+    "yarrow zephyr"
+).split()
+
+
+def metrics(url: str) -> dict[str, float]:
+    with urllib.request.urlopen(url + "/metrics", timeout=10) as response:
+        text = response.read().decode()
+    values = {}
+    for line in text.splitlines():
+        match = re.match(r"^(flare_[a-z_]+) ([0-9.e+-]+)$", line)
+        if match:
+            values[match[1]] = float(match[2])
+    return values
+
+
+def model_id(url: str) -> str:
+    with urllib.request.urlopen(url + "/v1/models", timeout=10) as response:
+        return json.load(response)["data"][0]["id"]
+
+
+def complete(url: str, model: str, messages: list[dict], template: dict | None, timeout: float) -> dict:
+    body = {"model": model, "messages": messages, "max_tokens": 32, "temperature": 0}
+    if template:
+        body["chat_template_kwargs"] = template
+    request = urllib.request.Request(
+        url + "/v1/chat/completions",
+        data=json.dumps(body).encode(),
+        headers={"Content-Type": "application/json"},
+    )
+    start = time.monotonic()
+    with urllib.request.urlopen(request, timeout=timeout) as response:
+        result = json.load(response)
+    usage = result["usage"]
+    return {
+        "seconds": time.monotonic() - start,
+        "prompt_tokens": usage["prompt_tokens"],
+        "cached_tokens": (usage.get("prompt_tokens_details") or {}).get("cached_tokens", 0),
+        "text": result["choices"][0]["message"].get("content") or "",
+    }
+
+
+def filler(rng: random.Random, words: int) -> str:
+    return " ".join(rng.choice(WORDS) for _ in range(words))
+
+
+def conversation(rng: random.Random, tokens: int, secret: str) -> list[dict]:
+    """A long conversation of several turns whose first user message holds the secret."""
+    turns = 8
+    # Roughly one token per filler word, plus separators.
+    per_turn = max(64, tokens // turns)
+    messages = [
+        {"role": "system", "content": "You are a careful assistant reviewing a long log."},
+        {"role": "user", "content": f"Remember this access code: {secret}. Log part 1: {filler(rng, per_turn)}"},
+        {"role": "assistant", "content": "Noted. Send the next part."},
+    ]
+    for part in range(2, turns + 1):
+        if part > 2:
+            messages.append({"role": "assistant", "content": "Noted. Send the next part."})
+        messages.append({"role": "user", "content": f"Log part {part}: {filler(rng, per_turn)}"})
+    return messages
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--url", help="A serving rank zero; omit to launch --flare")
+    parser.add_argument("--flare", type=Path)
+    parser.add_argument("--package", type=Path)
+    parser.add_argument("--gpus", default="0")
+    parser.add_argument("--port", type=int, default=18431)
+    parser.add_argument("--artifacts", type=Path, default=Path("prefix-retention"))
+    parser.add_argument("--extra", default="", help="Additional `flare run` flags for a launched server")
+    parser.add_argument("--conversation-tokens", type=int, default=32768)
+    parser.add_argument("--side-tokens", type=int, default=2048)
+    parser.add_argument("--side-turns", type=int, default=3)
+    parser.add_argument("--side-conversations", type=int, default=0,
+                        help="Short conversations; zero selects twice the server's snapshot slots")
+    parser.add_argument("--chat-template-kwargs", type=json.loads, default=None,
+                        help='JSON, e.g. \'{"enable_thinking": false}\'')
+    parser.add_argument("--timeout", type=float, default=3600)
+    parser.add_argument("--seed", type=int, default=20261025)
+    args = parser.parse_args()
+
+    server = None
+    if args.url:
+        url = args.url.rstrip("/")
+    else:
+        if not (args.flare and args.package):
+            parser.error("give --url, or --flare and --package")
+        from qualify.host_cache import Server
+
+        args.artifacts.mkdir(parents=True, exist_ok=True)
+        server = Server(args.flare, args.package, args.gpus, args.port,
+                        args.artifacts / "server.log", args.extra.split())
+        server.wait_ready(args.timeout)
+        url = server.url
+    try:
+        return run(url, args)
+    finally:
+        if server is not None:
+            server.stop()
+
+
+def run(url: str, args: argparse.Namespace) -> int:
+    rng = random.Random(args.seed)
+    model = model_id(url)
+    before = metrics(url)
+    slots = int(before.get("flare_free_snapshots", 0) + before.get("flare_cached_checkpoints", 0))
+    sides = args.side_conversations or max(8, 2 * slots)
+    secret = f"{rng.randrange(10**8):08d}"
+    messages = conversation(rng, args.conversation_tokens, secret)
+    report: dict = {"model": model, "snapshot_slots": slots, "side_conversations": sides}
+
+    first = complete(url, model, messages, args.chat_template_kwargs, args.timeout)
+    report["first"] = first
+    print(f"conversation: {first['prompt_tokens']} prompt tokens, {first['cached_tokens']} cached, "
+          f"{first['seconds']:.1f} s", flush=True)
+    messages.append({"role": "assistant", "content": first["text"]})
+
+    for side in range(sides):
+        thread = [{"role": "system", "content": f"You are subagent {side}. {filler(rng, 64)}"}]
+        for turn in range(args.side_turns):
+            thread.append({"role": "user", "content": f"Task {side}.{turn}: {filler(rng, args.side_tokens // args.side_turns)}"})
+            result = complete(url, model, thread, args.chat_template_kwargs, args.timeout)
+            thread.append({"role": "assistant", "content": result["text"]})
+    churn = metrics(url)
+    report["side_snapshot_evictions"] = churn.get("flare_snapshot_evictions_total", 0) - before.get("flare_snapshot_evictions_total", 0)
+    print(f"side conversations: {sides} x {args.side_turns} turns, "
+          f"{report['side_snapshot_evictions']:.0f} snapshot evictions", flush=True)
+
+    messages.append({"role": "user", "content": "What was the access code I asked you to remember? Reply with the digits only."})
+    follow = complete(url, model, messages, args.chat_template_kwargs, args.timeout)
+    report["follow_up"] = follow
+    covered = follow["cached_tokens"] >= first["prompt_tokens"]
+    recalled = secret in follow["text"]
+    print(f"follow-up: {follow['prompt_tokens']} prompt tokens, {follow['cached_tokens']} cached, "
+          f"{follow['seconds']:.1f} s (first turn {first['seconds']:.1f} s), answer {follow['text']!r}", flush=True)
+    report["passed"] = covered and recalled
+    args.artifacts.mkdir(parents=True, exist_ok=True)
+    (args.artifacts / "prefix_retention.json").write_text(json.dumps(report, indent=2) + "\n")
+    print("PASS" if report["passed"] else
+          f"FAIL: {'prefix not reused' if not covered else ''} {'' if recalled else 'access code not recalled'}".strip())
+    return 0 if report["passed"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
