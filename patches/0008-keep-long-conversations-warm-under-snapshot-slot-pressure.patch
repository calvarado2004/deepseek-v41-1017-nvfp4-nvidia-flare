+/// Evicts one checkpoint at a time while short requests keep eight endpoints live, and returns
+/// how many short endpoints went before the 1,024-token conversation did.
+fn short_evictions_before_the_conversation(renew_after: Option<usize>) -> usize {
+    let mut cache = PrefixCheckpointCache::new([7; 32], 512, 512, 64).unwrap();
+    let conversation = history(16, 0);
+    let main = created(
+        &mut cache,
+        &conversation,
+        &proposal(None, 1024, &(0..16).collect::<Vec<_>>(), 0, 0),
+    );
+    let mut next = 1u32;
+    let mut short = |cache: &mut PrefixCheckpointCache| {
+        created(
+            cache,
+            &history(1, 1000 * next),
+            &proposal(None, 64, &[15 + next], next, 0),
+        );
+        next += 1;
+    };
+    for _ in 0..8 {
+        short(&mut cache);
+    }
+    let mut rounds = 0;
+    loop {
+        let report = cache.evict(EvictionTarget { pages: 0, snapshots: 1 });
+        if report.retired[0].checkpoint == main {
+            assert_eq!(cache.lookup(&conversation).unwrap().checkpoint, None);
+            return rounds;
+        }
+        rounds += 1;
+        if Some(rounds) == renew_after {
+            // A new turn of the conversation renews its credit.
+            assert_eq!(cache.lookup(&conversation).unwrap().checkpoint, Some(main));
+        }
+        short(&mut cache);
+    }
+}
+
+#[test]
+fn a_long_conversation_outlives_short_requests_until_its_credit_ages_out() {
+    // Recency alone retires the conversation first. GreedyDual-Size keeps it while the
+    // inflation climbs one short endpoint's tokens per generation of eight live endpoints.
+    assert_eq!(short_evictions_before_the_conversation(None), (1024 / 64 - 1) * 8);
+    let renewed = short_evictions_before_the_conversation(Some(100));
+    assert!(renewed >= 100 + (1024 / 64 - 1) * 8, "{renewed}");
+}
+
+#[test]
+fn compaction_keeps_the_conversation_credit() {
+    let mut cache = cache();
+    let conversation = history(4, 0);
+    let root = created(&mut cache, &conversation, &proposal(None, 64, &[0], 0, 0));
+    let leaf = created(&mut cache, &conversation, &proposal(Some(root), 256, &[1, 2, 3], 1, 0));
+    let other = created(&mut cache, &history(1, 500), &proposal(None, 64, &[4], 2, 0));
+    // The ancestor loses no tokens and compacts first; the short endpoint goes next.
+    let report = cache.evict(EvictionTarget { pages: 1, snapshots: 0 });
+    assert_eq!(report.retired[0].checkpoint, root);
+    let report = cache.evict(EvictionTarget { pages: 1, snapshots: 0 });
+    assert_eq!(report.retired[0].checkpoint, other);
+    assert_eq!(cache.lookup(&conversation).unwrap().checkpoint, Some(leaf));
+}
