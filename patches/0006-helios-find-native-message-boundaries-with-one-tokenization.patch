+
+fn boundary_tools() -> Value {
+    json!([{"type":"function","function":{"name":"read_file","description":"Read a file",
+        "parameters":{"type":"object","properties":{"path":{"type":"string"}}}}}])
+}
+
+/// An agent session: tool calls and results, kept and dropped reasoning, Unicode, runs of
+/// whitespace, code, and text that looks like special tokens.
+fn agent_session(turns: usize, filler: usize) -> Vec<Value> {
+    let texts = [
+        "plain words and numbers 12345",
+        "  leading spaces\n\n\ttabs\r\nand blank lines\n\n\n",
+        "Unicode: café, 日本語, emoji 🦀🚀, combining e\u{301}, full-width ｜bar｜",
+        "```rust\nfn main() {\n    println!(\"{}\", 1 + 1);\n}\n```",
+        "looks special: <｜User｜ and <think without closing, </think trailing",
+        "trailing space ",
+    ];
+    let mut messages = vec![json!({"role":"system","content":"You are a coding agent."})];
+    for turn in 0..turns {
+        let text = format!("{} {}", texts[turn % texts.len()], "x".repeat(filler));
+        let id = format!("call_{turn}");
+        messages.push(json!({"role":"user","content":format!("turn {turn}: {text}")}));
+        messages.push(json!({"role":"assistant","reasoning_content":format!("think {turn}"),
+            "content":"", "tool_calls":[{"id":id,"type":"function","function":{"name":"read_file",
+            "arguments":format!("{{\"path\":\"src/{turn}.rs\"}}")}}]}));
+        messages.push(json!({"role":"tool","tool_call_id":id,"content":text}));
+        messages.push(json!({"role":"assistant","content":format!("done {turn}: {text}")}));
+    }
+    messages.push(json!({"role":"user","content":"Continue."}));
+    messages
+}
+
+fn rendered_for(f: &Fixture, messages: &[Value], options: &Map<String, Value>) -> frontend::RenderedPrompt {
+    let mut options = options.clone();
+    options.insert("add_generation_prompt".into(), true.into());
+    f.frontend.render_chat(messages, &options).unwrap()
+}
+
+#[test]
+fn native_boundaries_equal_per_prefix_tokenization() {
+    for encoder in [PromptEncoder::DeepseekV4, PromptEncoder::DeepseekV41] {
+        let f = Fixture::new(encoder);
+        let mut options = Map::new();
+        options.insert("tools".into(), boundary_tools());
+        for (turns, filler) in [(1, 0), (6, 3), (40, 17)] {
+            let messages = agent_session(turns, filler);
+            let rendered = rendered_for(&f, &messages, &options);
+            assert!(f.frontend.native_token_ranges(&rendered).is_some(), "{encoder:?}");
+            let expected = model::message_boundaries(&f.frontend, &rendered.token_ids, &messages, &options);
+            let actual = model::rendered_message_boundaries(&f.frontend, &rendered, &messages, &options);
+            assert!(!expected.is_empty());
+            assert_eq!(actual, expected, "{encoder:?}, {turns} turns");
+        }
+    }
+}
+
+#[test]
+fn prepared_requests_keep_per_prefix_boundaries() {
+    for encoder in [PromptEncoder::DeepseekV4, PromptEncoder::DeepseekV41] {
+        let f = Fixture::new(encoder);
+        let messages = agent_session(12, 5);
+        let prepared = f.prepare(json!({"messages":messages,"tools":boundary_tools()})).unwrap();
+        let mut options = Map::new();
+        options.insert("tools".into(), boundary_tools());
+        let expected = model::message_boundaries(&f.frontend, &prepared.prompt.tokens, &messages, &options);
+        assert_eq!(prepared.prompt.message_boundaries, expected, "{encoder:?}");
+        // Every user turn after the first assistant reply starts a reusable prefix.
+        assert!(expected.len() >= 12, "{encoder:?}: {expected:?}");
+    }
+}
+
+#[test]
+fn native_boundaries_count_image_placeholders_as_one_token() {
+    let f = Fixture::new(PromptEncoder::DeepseekV4);
+    let image = "data:image/png;base64,iVBORw0KGgo=";
+    let mut messages = vec![json!({"role":"user","content":[
+        {"type":"image_url","image_url":{"url":image}},{"type":"text","text":"What is this?"}]})];
+    messages.push(json!({"role":"assistant","content":"A screenshot."}));
+    messages.push(json!({"role":"user","content":[{"type":"text","text":"And this one?"},
+        {"type":"image_url","image_url":{"url":image}}]}));
+    messages.push(json!({"role":"assistant","content":"Another one, 日本語 🦀."}));
+    messages.push(json!({"role":"user","content":"Compare them."}));
+    let rendered = rendered_for(&f, &messages, &Map::new());
+    assert_eq!(rendered.image_sources.len(), 2);
+    assert!(f.frontend.native_token_ranges(&rendered).is_some());
+    let expected = model::message_boundaries(&f.frontend, &rendered.token_ids, &messages, &Map::new());
+    assert!(expected.len() >= 2, "{expected:?}");
+    assert_eq!(model::rendered_message_boundaries(&f.frontend, &rendered, &messages, &Map::new()), expected);
+}
+
+#[test]
+fn native_boundaries_fall_back_when_offsets_do_not_reproduce_the_prompt() {
+    let f = Fixture::new(PromptEncoder::DeepseekV41);
+    let messages = agent_session(5, 2);
+    let mut rendered = rendered_for(&f, &messages, &Map::new());
+    let last = rendered.token_ids.len() - 1;
+    rendered.token_ids[last] ^= 1;
+    assert!(f.frontend.native_token_ranges(&rendered).is_none());
+    let expected = model::message_boundaries(&f.frontend, &rendered.token_ids, &messages, &Map::new());
+    assert!(!expected.is_empty());
+    assert_eq!(model::rendered_message_boundaries(&f.frontend, &rendered, &messages, &Map::new()), expected);
+    let jinja = Fixture::new(PromptEncoder::Jinja);
+    let rendered = rendered_for(&jinja, &messages, &Map::new());
+    assert!(jinja.frontend.native_token_ranges(&rendered).is_none());
+    assert!(jinja.frontend.render_boundary_text(&messages, &Map::new()).is_none());
+}
+
+#[test]
+fn native_boundaries_do_not_tokenize_every_prefix() {
+    // 242 messages of ~1 KB: message_boundaries tokenizes every one of the growing prefixes.
+    let f = Fixture::new(PromptEncoder::DeepseekV41);
+    let messages = agent_session(60, 1000);
+    let rendered = rendered_for(&f, &messages, &Map::new());
+    let start = std::time::Instant::now();
+    let expected = model::message_boundaries(&f.frontend, &rendered.token_ids, &messages, &Map::new());
+    let reference = start.elapsed();
+    let start = std::time::Instant::now();
+    let actual = model::rendered_message_boundaries(&f.frontend, &rendered, &messages, &Map::new());
+    let native = start.elapsed();
+    eprintln!("{} tokens, {} boundaries: per-prefix {reference:?}, native {native:?}",
+        rendered.token_ids.len(), actual.len());
+    assert_eq!(actual, expected);
+    assert!(native * 5 < reference, "per-prefix {reference:?}, native {native:?}");
+}
+
+#[test]
+#[ignore = "requires FLARE_DEEPSEEK_TEST_SNAPSHOT pointing to the DeepSeek checkpoint"]
+fn native_boundaries_equal_per_prefix_tokenization_with_the_checkpoint_tokenizer() {
+    let root = std::path::PathBuf::from(std::env::var_os("FLARE_DEEPSEEK_TEST_SNAPSHOT").unwrap());
+    let asset = |path: std::path::PathBuf| Asset {
+        sha256: format!("{:x}", Sha256::digest(std::fs::read(&path).unwrap())),
+        path,
+        range: None,
+    };
+    let tokens = support::tokens(&asset(root.join("tokenizer_config.json"))).unwrap();
+    for encoder in [PromptEncoder::DeepseekV4, PromptEncoder::DeepseekV41] {
+        let settings = FrontendSettings {
+            tokenizer: tokens.clone(),
+            eos_token_ids: vec![],
+            prompt_encoder: encoder,
+            image_placeholder_token_id: None,
+            template_encoding: Default::default(),
+            image: None,
+        };
+        let frontend = Frontend::load_with_settings(
+            FrontendAssets {
+                tokenizer: asset(root.join("tokenizer.json")),
+                tokens: tokens.clone(),
+                chat_template: None,
+            },
+            Map::new(),
+            &settings,
+        )
+        .unwrap();
+        let mut options = Map::new();
+        options.insert("tools".into(), boundary_tools());
+        let messages = agent_session(40, 300);
+        let mut render = options.clone();
+        render.insert("add_generation_prompt".into(), true.into());
+        let rendered = frontend.render_chat(&messages, &render).unwrap();
+        assert!(frontend.native_token_ranges(&rendered).is_some(), "{encoder:?}");
+        let expected = model::message_boundaries(&frontend, &rendered.token_ids, &messages, &options);
+        assert!(expected.len() >= 40, "{encoder:?}: {expected:?}");
+        assert_eq!(
+            model::rendered_message_boundaries(&frontend, &rendered, &messages, &options),
+            expected,
+            "{encoder:?}"
+        );
+    }
+}
