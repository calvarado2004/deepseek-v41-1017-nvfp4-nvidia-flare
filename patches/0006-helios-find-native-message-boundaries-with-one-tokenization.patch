+
+    /// Render the text of a message prefix without its generation header, without
+    /// tokenizing it. None for Jinja templates.
+    pub fn render_boundary_text(
+        &self,
+        messages: &[Json],
+        options: &Map<String, Json>,
+    ) -> Option<Result<String>> {
+        if self.prompt_encoder == PromptEncoder::Jinja {
+            return None;
+        }
+        let mut options = options.clone();
+        options.insert("add_generation_prompt".into(), true.into());
+        options.insert("continue_final_message".into(), false.into());
+        Some(render_text(self, messages, &options, false).map(|rendered| rendered.prompt))
+    }
+
+    /// Byte range of every token of a native prompt, from one encoding of its text spans.
+    /// None for Jinja templates, or when the offsets are unordered or the encoding does not
+    /// reproduce `rendered.token_ids` exactly.
+    pub fn native_token_ranges(&self, rendered: &RenderedPrompt) -> Option<Vec<(usize, usize)>> {
+        if self.prompt_encoder == PromptEncoder::Jinja {
+            return None;
+        }
+        let mut ids = Vec::with_capacity(rendered.token_ids.len());
+        let mut ranges = Vec::with_capacity(rendered.token_ids.len());
+        let mut base = 0;
+        for (index, span) in rendered.text.split(IMAGE_SPECIAL_TOKEN).enumerate() {
+            if index != 0 {
+                // render_prompt puts the image placeholder ID in place of the marker text.
+                ids.push(*rendered.token_ids.get(ids.len())?);
+                ranges.push((base, base + IMAGE_SPECIAL_TOKEN.len()));
+                base += IMAGE_SPECIAL_TOKEN.len();
+            }
+            let encoding = self.tokenizer.encode(span, false).ok()?;
+            ids.extend_from_slice(encoding.get_ids());
+            ranges.extend(encoding.get_offsets().iter().map(|&(start, end)| (base + start, base + end)));
+            base += span.len();
+        }
+        let ordered = ranges.windows(2).all(|pair| pair[0].0 <= pair[1].0)
+            && ranges.iter().all(|&(start, end)| start <= end && end <= rendered.text.len());
+        (ordered && ids == rendered.token_ids).then_some(ranges)
+    }
 }
