+/// `message_boundaries` of a complete rendered prompt. Native encoders cut the prompt's
+/// own tokens where each prefix's text ends, so the prompt is tokenized once: tokenizing
+/// every prefix costs messages x prompt length, minutes at 300K tokens. Other encoders,
+/// and encodings whose offsets do not reproduce the prompt, use `message_boundaries`.
+pub fn rendered_message_boundaries(
+    frontend: &Frontend,
+    rendered: &RenderedPrompt,
+    messages: &[Value],
+    options: &Map<String, Value>,
+) -> Vec<usize> {
+    let Some(ranges) = frontend.native_token_ranges(rendered) else {
+        return message_boundaries(frontend, &rendered.token_ids, messages, options);
+    };
+    let options = boundary_options(options);
+    let mut boundaries = Vec::with_capacity(messages.len());
+    for count in 0..=messages.len() {
+        let Some(Ok(prefix)) = frontend.render_boundary_text(&messages[..count], &options) else {
+            continue;
+        };
+        let end = prefix.len();
+        if end == 0 || !rendered.text.starts_with(&prefix) {
+            continue;
+        }
+        let length = ranges.partition_point(|&(start, _)| start < end);
+        if length > 0 && length < rendered.token_ids.len() && ranges[length - 1].1 <= end {
+            boundaries.push(length);
+        }
+    }
+    boundaries.sort_unstable();
+    boundaries.dedup();
+    boundaries
+}
+
+fn boundary_options(options: &Map<String, Value>) -> Map<String, Value> {
+    let mut options = options.clone();
+    options.insert("add_generation_prompt".into(), false.into());
+    options.insert("continue_final_message".into(), false.into());
+    options
+}
+
