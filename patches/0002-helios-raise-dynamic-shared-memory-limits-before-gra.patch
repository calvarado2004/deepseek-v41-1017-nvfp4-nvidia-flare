From b9617964e1b7713ae915326db7d601535b76f6c0 Mon Sep 17 00:00:00 2001
From: Carlos Alvarado Martinez <45523697+calvarado2004@users.noreply.github.com>
Date: Wed, 21 Oct 2026 23:11:27 -0400
Subject: [PATCH 2/3] helios: raise dynamic shared memory limits before
 graph-node reconstruction (issue #2 patch by dbotwinick)

---
 .../src/runtime_package/cooperative_tests.rs  |  4 +--
 helios/src/runtime_package/driver.rs          |  1 +
 helios/src/runtime_package/mod.rs             | 34 ++++++++++++++++++-
 helios/tests/cooperative_package_fixture.py   | 12 +++++--
 4 files changed, 45 insertions(+), 6 deletions(-)

diff --git a/helios/src/runtime_package/cooperative_tests.rs b/helios/src/runtime_package/cooperative_tests.rs
index ced200d..e9aaeb3 100644
--- a/helios/src/runtime_package/cooperative_tests.rs
+++ b/helios/src/runtime_package/cooperative_tests.rs
@@ -35,7 +35,7 @@ fn cooperative_grid_clamping_rejects_planes_above_capacity() {
 
 #[test]
 #[ignore = "requires FLARE_COOPERATIVE_TEST_PACKAGE exported by cooperative_package_fixture.py on the assigned GPU"]
-fn oversized_cooperative_grids_replay_at_device_capacity() {
+fn cooperative_grids_and_dynamic_shared_memory_replay_at_device_capacity() {
     let root =
         std::path::PathBuf::from(std::env::var_os("FLARE_COOPERATIVE_TEST_PACKAGE").unwrap());
     let owner =
@@ -60,7 +60,7 @@ fn oversized_cooperative_grids_replay_at_device_capacity() {
                 assert_eq!(values[i], i as i32 * 3 + 7, "{name}: element {i}");
                 assert_eq!(
                     values[length + i],
-                    if name == "ordinary" {
+                    if name.starts_with("ordinary") {
                         -1
                     } else {
                         (length - 1 - i) as i32 * 3 + 18
diff --git a/helios/src/runtime_package/driver.rs b/helios/src/runtime_package/driver.rs
index dc73e7e..ba286b6 100644
--- a/helios/src/runtime_package/driver.rs
+++ b/helios/src/runtime_package/driver.rs
@@ -144,6 +144,7 @@ driver! {
     module_unload: "cuModuleUnload"(Handle);
     function: "cuModuleGetFunction"(*mut Handle, Handle, *const c_char);
     parameter_info: "cuFuncGetParamInfo"(Handle, usize, *mut usize, *mut usize);
+    function_get_attribute: "cuFuncGetAttribute"(*mut c_int, c_int, Handle);
     function_attribute: "cuFuncSetAttribute"(Handle, c_int, c_int);
     function_load: "cuFuncLoad"(Handle);
     occupancy: "cuOccupancyMaxActiveBlocksPerMultiprocessor"(*mut c_int, Handle, c_int, usize);
diff --git a/helios/src/runtime_package/mod.rs b/helios/src/runtime_package/mod.rs
index 8764206..34d19ba 100644
--- a/helios/src/runtime_package/mod.rs
+++ b/helios/src/runtime_package/mod.rs
@@ -36,7 +36,7 @@ pub use model::{
 };
 pub use selection::LoadOptions;
 
-use std::collections::HashMap;
+use std::collections::{HashMap, hash_map::Entry};
 use std::ffi::CString;
 use std::ptr::{null, null_mut};
 use std::sync::Arc;
@@ -577,6 +577,7 @@ impl NativeResources {
                 driver.check("cuEventCreate", (driver.event_create)(&mut event, 2))?;
                 self.events.insert(name.clone(), event);
             }
+            let mut dynamic_limits = HashMap::new();
             for graph in &package.graphs {
                 let mut handle = null_mut();
                 driver.check("cuGraphCreate", (driver.graph_create)(&mut handle, 0))?;
@@ -610,6 +611,37 @@ impl NativeResources {
                                 .collect::<Result<Vec<_>>>()?;
                             let mut pointers: Vec<_> =
                                 storage.iter_mut().map(|a| a.as_mut_ptr().cast()).collect();
+                            // Captured nodes can require more dynamic shared memory than
+                            // the function's current/exported opt-in limit. Restore the
+                            // requirement before CUDA validates the new kernel node.
+                            let required = i32::try_from(*shared)
+                                .map_err(|_| invalid("kernel dynamic shared memory exceeds i32"))?;
+                            let limit = match dynamic_limits.entry(self.functions[function]) {
+                                Entry::Occupied(entry) => entry.into_mut(),
+                                Entry::Vacant(entry) => {
+                                    let mut value = 0;
+                                    driver.check(
+                                        "cuFuncGetAttribute",
+                                        (driver.function_get_attribute)(
+                                            &mut value,
+                                            8,
+                                            self.functions[function],
+                                        ),
+                                    )?;
+                                    entry.insert(value)
+                                }
+                            };
+                            if required > *limit {
+                                driver.check(
+                                    "cuFuncSetAttribute",
+                                    (driver.function_attribute)(
+                                        self.functions[function],
+                                        8,
+                                        required,
+                                    ),
+                                )?;
+                                *limit = required;
+                            }
                             let mut params = KernelParams {
                                 function: self.functions[function],
                                 grid: *grid,
diff --git a/helios/tests/cooperative_package_fixture.py b/helios/tests/cooperative_package_fixture.py
index 14858ce..affafdd 100644
--- a/helios/tests/cooperative_package_fixture.py
+++ b/helios/tests/cooperative_package_fixture.py
@@ -73,8 +73,10 @@ extern "C" __global__ void ordinary(int *out, int n) { work<false>(out, n); }
         ("partitioned_y", (32, 4, 1), 0, (2, 3), "large", 1),
         ("partitioned_z", (32, 4, 1), 0, (2, 3), "large", 2),
         ("ordinary", (32, 4, 1), 0, (1, 1), "large", 0),
+        ("ordinary_shared", (32, 4, 1), 65536, (1, 1), "large", 0),
+        ("ordinary_smaller_shared", (32, 4, 1), 32768, (1, 1), "large", 0),
     ):
-        function = functions["ordinary" if name == "ordinary" else "cooperative"]
+        function = functions["ordinary" if name.startswith("ordinary") else "cooperative"]
         occupancy = C.c_int()
         cuda.call("cuOccupancyMaxActiveBlocksPerMultiprocessor", C.byref(occupancy), function,
                   C.c_int(block[0] * block[1] * block[2]), C.c_size_t(shared))
@@ -83,7 +85,7 @@ extern "C" __global__ void ordinary(int *out, int n) { work<false>(out, n); }
         workers = 3 if size == "small" else max_workers if size == "exact" else max_workers + 7
         captured_grid, expected_grid = list(other), list(other)
         captured_grid.insert(axis, workers)
-        expected_grid.insert(axis, workers if name == "ordinary" else min(workers, max_workers))
+        expected_grid.insert(axis, workers if name.startswith("ordinary") else min(workers, max_workers))
         output = C.c_uint64()
         nbytes = (length * 2 + 3) * 4
         cuda.call("cuMemAlloc_v2", C.byref(output), C.c_size_t(nbytes))
@@ -95,7 +97,7 @@ extern "C" __global__ void ordinary(int *out, int n) { work<false>(out, n); }
         params = _KernelParams(func=function.value, grid=(C.c_uint * 3)(*captured_grid),
                                block=(C.c_uint * 3)(*block), shared=shared, params=arguments)
         cuda.call("cuGraphAddKernelNode_v2", C.byref(node), graph, None, C.c_size_t(0), C.byref(params))
-        if name != "ordinary":
+        if not name.startswith("ordinary"):
             cooperative = (C.c_uint64 * 8)(1)
             status = cuda.lib.cuGraphKernelNodeSetAttribute(node, C.c_int(2), C.byref(cooperative))
             if size == "large":
@@ -126,6 +128,10 @@ extern "C" __global__ void ordinary(int *out, int n) { work<false>(out, n); }
 
     package = WorkerPackage(allocations=allocations, modules={"workers": cubin.read_bytes()},
         kernels=[Kernel(f.value, "workers", (Argument(8), Argument(4))) for f in functions.values()])
+    # A captured graph retains its launch requirement even if the function's
+    # current opt-in limit is lowered before export. Reproduce such packages.
+    for function in functions.values():
+        cuda.call("cuFuncSetAttribute", function, C.c_int(8), C.c_int(49152))
     package.write(root / "package", graphs, publisher=publisher())
     (root / "expected.json").write_text(json.dumps({"length": length, "grids": expected}))
     cuda.call("cuCtxDestroy_v2", context)
